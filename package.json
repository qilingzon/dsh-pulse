{
  "name": "dsh-pulse",
  "version": "0.7.0",
  "description": "客户端插件：用 slot 阴影顶替内置统计行，把「缓存命中」显示为两位小数（页面上只留一枚读数）；另加一枚只读的 10 秒滑窗平均输出速度（tok/s），区分流中估计与结算后 provider 真值两态。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "profile-edit.cjs",
    "install.ps1",
    "uninstall.ps1",
    "install.sh",
    "verify.mjs",
    "smoke.mjs",
    "bench.mjs",
    "HARNESS_PLUGIN.md",
    "README.md",
    "TEST_COVERAGE.md",
    "TECHNIQUES.md",
    "ECOSYSTEM.md",
    "STABILITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cache-hit",
    "token-usage",
    "tokens-per-second",
    "composer-dock"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qilingzon/dsh-pulse.git"
  },
  "homepage": "https://github.com/qilingzon/dsh-pulse#readme",
  "bugs": {
    "url": "https://github.com/qilingzon/dsh-pulse/issues"
  },
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js",
    "harness:verify": "node verify.mjs",
    "harness:smoke": "node smoke.mjs",
    "harness:test": "node verify.mjs && node smoke.mjs",
    "harness:bench": "node bench.mjs"
  },
  "dsh": {
    "id": "dsh-pulse",
    "name": "缓存命中两位小数（顶替内置）+ 精确输出速度",
    "version": "0.7.0",
    "repo": "github/qilingzon/dsh-pulse",
    "permissions": "客户端 slot 注册（只读 useProjection，无宿主侧改动）",
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
